{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Main App",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/src/cmd/main-app",
      "cwd": "${workspaceFolder}",
      "env": {
        "API_GATEWAY_ADDR": ":8080",
        "RABBITMQ_URL": "amqp://guest:guest@localhost:5672/",
        "PAYMENTS_QUEUE": "payments",
        "PAYMENT_PROCESSED_QUEUE": "payment_processed",
        "MESSAGE_LIMIT": "100"
      }
    }
  ]
}
