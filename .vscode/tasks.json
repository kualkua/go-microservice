{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "RabbitMQ: up",
      "type": "shell",
      "command": "docker compose up -d rabbitmq",
      "problemMatcher": []
    },
    {
      "label": "RabbitMQ: down",
      "type": "shell",
      "command": "docker compose down",
      "problemMatcher": []
    },
    {
      "label": "Run Main App",
      "type": "shell",
      "command": "go run ./src/cmd/main-app",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "API_GATEWAY_ADDR": ":8080",
          "RABBITMQ_URL": "amqp://guest:guest@localhost:5672/",
          "PAYMENTS_QUEUE": "payments",
          "PAYMENT_PROCESSED_QUEUE": "payment_processed",
          "MESSAGE_LIMIT": "100"
        }
      },
      "problemMatcher": []
    }
  ]
}
